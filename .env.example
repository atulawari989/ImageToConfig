# Copy this file to ".env" and fill in your ROTATED Anthropic API key.
# The .env file is gitignored and must never be committed.
#
# Get a key at https://console.anthropic.com  (API Keys).
# If a key has ever been pasted into a chat / shared, ROTATE it first.

ANTHROPIC_API_KEY=sk-ant-your-rotated-key-here

# Optional — override the default model (defaults to claude-opus-4-8):
# ANTHROPIC_MODEL=claude-opus-4-8
